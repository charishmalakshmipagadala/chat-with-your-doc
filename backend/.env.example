# Copy this file to .env and fill in real values. Never commit .env.
PORT=3001
# Postgres in Docker (see docker-compose.yml)
DATABASE_URL=postgresql://docchat:docchat@localhost:5432/docchat
ANTHROPIC_API_KEY=sk-ant-...
# Optional: which Claude model to use (default: claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5
# true = stream fake replies without calling Claude (free, no key/credit needed)
FAKE_LLM=false
